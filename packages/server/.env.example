# Server Configuration
PORT=3001

# MongoDB Configuration
MONGO_URI="your_mongodb_connection_string"

# Secret used to sign admin login tokens. REQUIRED: the server will not start
# without it, and it must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing it signs out every logged-in admin.
JWT_SECRET=""

# Websites allowed to call this API from a browser, comma-separated, no trailing
# slash. Defaults to http://localhost:5173 when unset.
# Example: https://thepalaceschool.com,https://www.thepalaceschool.com,http://localhost:5173
CORS_ORIGINS=""

# Used only by `npm run create-admin` (see scripts/createAdminUser.ts).
# Prefer setting ADMIN_PASSWORD just for that one command instead of saving it here.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Admin"

# Optional, local dev only: comma-separated DNS servers if mongodb+srv lookups fail
# (querySrv ECONNREFUSED). Leave unset in production.
# DNS_SERVERS=8.8.8.8,1.1.1.1
